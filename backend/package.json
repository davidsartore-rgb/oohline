{
  "name": "oohline-backend",
  "version": "1.0.0",
  "description": "OOH Line — production API backend",
  "private": true,
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "postinstall": "npx prisma generate",
