    "@fastify/rate-limit": "^9.1.0",
    "@fastify/static": "^7.0.4",
    "@prisma/adapter-mysql": "^5.14.0",
    "@prisma/client": "^5.14.0",
    "mysql2": "^3.9.0",
    "argon2": "^0.31.2",
    "dotenv": "^16.4.5",
    "fastify": "^4.27.0",
    "nodemailer": "^6.9.13",
    "pino": "^9.2.0",
    "pino-pretty": "^11.0.0",
    "qrcode": "^1.5.3",
    "speakeasy": "^2.0.0",
    "xlsx": "^0.18.5",
