# ── Database ──────────────────────────────────────────────────────────────────
# Hostinger MariaDB 10.6. Replace with real credentials.
DATABASE_URL="mysql://oohline:YOUR_DB_PASSWORD@localhost:3306/oohline"

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# ── Sessions ──────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="CHANGE_ME_to_a_64char_hex_random_string"
COOKIE_DOMAIN=oohline.ch
COOKIE_SECURE=true

# ── Email — Hostinger SMTP (startup) ──────────────────────────────────────────
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@oohline.ch
SMTP_PASS=YOUR_EMAIL_PASSWORD
SMTP_FROM="OOH Line <noreply@oohline.ch>"
CONTACT_EMAIL=devis@oohline.ch

# ── Email — Postmark (optional, set SMTP_PROVIDER=postmark to activate) ────────
# SMTP_PROVIDER=postmark
# POSTMARK_API_KEY=YOUR_POSTMARK_API_KEY

# ── Admin seed ────────────────────────────────────────────────────────────────
# Used ONLY during first-run seed (prisma/seed.js). Change immediately after.
ADMIN_USERNAME=admin
ADMIN_PASSWORD="S?3Wq9Z$:8hmf6"

# ── Feature flags ─────────────────────────────────────────────────────────────
# Set to true after initial data import to lock the endpoint
DISABLE_IMPORT=false
# Base URL for magic-link emails
APP_URL=https://oohline.ch
